# gRPC listening address
GRPC_ADDR=:50051

# Prometheus metrics HTTP server listening address
METRICS_ADDR=:2112

# PostgreSQL connection string
DATABASE_URL=postgres://resilient:resilient@localhost:5432/payments?sslmode=disable

# Redis server address for idempotency cache
REDIS_ADDR=localhost:6379

# Time-To-Live for cached idempotency keys in Redis
IDEMPOTENCY_TTL=24h

# Per-request database query timeout
DB_TIMEOUT=2s
